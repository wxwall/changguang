<view class="venues-page">
  <!-- 顶部搜索与统计栏 -->
  <view class="search-header">
    <view class="search-box">
      <text class="search-icon">🔍</text>
      <input
        class="search-input"
        placeholder="搜索场馆名称或编号..."
        placeholder-class="search-placeholder"
        value="{{keyword}}"
        bindinput="onSearchInput"
      />
      <text wx:if="{{keyword}}" class="search-clear" bindtap="onClearSearch">✕</text>
    </view>
    <text class="venue-count">共 {{filteredVenues.length}} 座场馆</text>
  </view>

  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="state-box">
    <view class="state-ring"></view>
    <text class="state-text">正在从服务器加载全部场馆...</text>
  </view>

  <!-- 空状态 -->
  <view wx:elif="{{filteredVenues.length === 0}}" class="state-box">
    <text class="state-text">暂无匹配的场馆</text>
  </view>

  <!-- 场馆列表 -->
  <scroll-view wx:else class="venue-list-scroll" scroll-y="true">
    <view class="venue-list">
      <view
        wx:for="{{filteredVenues}}"
        wx:key="id"
        class="venue-card {{(currentId && (currentId === item.id || currentId === item._id)) ? 'active' : ''}}"
        data-id="{{item.id}}"
        data-doc-id="{{item._id}}"
        data-name="{{item.shortLabel || item.name}}"
        bindtap="onPickVenue"
      >
        <view class="venue-card-main">
          <view class="venue-card-title-row">
            <text class="venue-card-name">{{item.name || item.shortLabel}}</text>
            <text
              wx:if="{{currentId && (currentId === item.id || currentId === item._id)}}"
              class="current-tag"
            >当前</text>
          </view>
          <text class="venue-card-sub">{{item.capLabel}}</text>
        </view>
        <view class="venue-card-right">
          <text class="tier-badge">{{item.tierCount}} 层看台</text>
          <text class="enter-arrow">›</text>
        </view>
      </view>
    </view>
  </scroll-view>
</view>

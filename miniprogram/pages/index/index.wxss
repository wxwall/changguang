.app-shell {
  display: flex;
  flex-direction: column;
  width: 100vw;
  height: 100vh;
  background-color: #f6eee3;
  color: #1E293B;
  overflow: hidden;
}

/* 顶部栏：最左侧全部按钮 + 5个场馆切换 */
.top-header {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #f6eee3;
  border-bottom: 1rpx solid rgba(120, 95, 70, 0.14);
  padding: 10rpx 18rpx 10rpx;
}

.venue-all-btn {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 70rpx;
  padding: 0 22rpx;
  border-radius: 12rpx;
  background: #1E293B;
  border: 1rpx solid #1E293B;
}

.venue-all-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #f6eee3;
  white-space: nowrap;
}

.venue-tabs {
  flex: 1;
  min-width: 0;
  display: flex;
  white-space: nowrap;
  height: 70rpx;
}

.venue-chip {
  display: inline-flex;
  flex-direction: column;
  justify-content: center;
  padding: 6rpx 20rpx;
  margin-right: 12rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.82);
  border: 1rpx solid rgba(120, 95, 70, 0.18);
  flex-shrink: 0;
}

.venue-chip.active {
  background: rgba(244, 63, 94, 0.12);
  border-color: #F43F5E;
}

.venue-chip-code {
  font-size: 24rpx;
  font-weight: 600;
  color: #1E293B;
}

.venue-chip.active .venue-chip-code {
  color: #E11D48;
}

.venue-chip-cap {
  font-size: 18rpx;
  color: #64748B;
  margin-top: 2rpx;
}

/* 主视口容器：3D 上方，2D 下方 */
.viewport-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
  background-color: #f6eee3;
}

.pane-3d,
.pane-2d {
  position: relative;
  width: 100%;
  overflow: hidden;
}

.pane-3d.split-top {
  height: 46%;
  border-bottom: 1rpx solid rgba(120, 95, 70, 0.16);
}

.pane-3d.full {
  height: 100%;
}

.pane-2d.split-bottom {
  height: 54%;
  background-color: #f6eee3;
}

.pane-2d.hidden {
  height: 0;
  min-height: 0;
  overflow: hidden;
}

.canvas-el {
  width: 100%;
  height: 100%;
  display: block;
}

/* 3D 浮层控件 */
.hud-top-3d {
  position: absolute;
  top: 12rpx;
  left: 14rpx;
  right: 14rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  pointer-events: none;
}

.hud-left-3d {
  display: flex;
  align-items: center;
  gap: 10rpx;
  max-width: 78%;
}

.camera-badge {
  display: flex;
  align-items: center;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  font-size: 19rpx;
  background: rgba(246, 238, 227, 0.92);
  border: 1rpx solid rgba(120, 95, 70, 0.22);
  color: #1E293B;
  overflow: hidden;
}

.camera-badge.seat-mode {
  border-color: rgba(244, 63, 94, 0.65);
}

.badge-text {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.badge-dot {
  width: 10rpx;
  height: 10rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: #0284C7;
  margin-right: 8rpx;
}

.camera-badge.seat-mode .badge-dot {
  background: #F43F5E;
}

.hud-action-btn {
  pointer-events: auto;
  flex-shrink: 0;
  padding: 6rpx 14rpx;
  font-size: 19rpx;
  font-weight: 600;
  color: #FFFFFF;
  border-radius: 8rpx;
}

.hud-action-btn.primary {
  background: #2563EB;
}

.hud-action-btn.accent {
  background: rgba(244, 63, 94, 0.92);
}

.hud-action-btn.scene-btn {
  background: rgba(16, 185, 129, 0.92);
  border: 1rpx solid rgba(5, 150, 105, 0.45);
}

.hud-right-3d {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.fullscreen-btn-3d {
  pointer-events: auto;
  flex-shrink: 0;
  padding: 7rpx 16rpx;
  font-size: 20rpx;
  font-weight: 600;
  color: #1E293B;
  background: rgba(246, 238, 227, 0.92);
  border: 1rpx solid rgba(120, 95, 70, 0.25);
  border-radius: 8rpx;
}

.zoom-bar-3d {
  position: absolute;
  bottom: 12rpx;
  right: 14rpx;
  display: flex;
  background: rgba(246, 238, 227, 0.92);
  padding: 4rpx;
  border-radius: 10rpx;
  border: 1rpx solid rgba(120, 95, 70, 0.22);
}

.zoom-chip {
  padding: 5rpx 12rpx;
  font-size: 19rpx;
  color: #475569;
  border-radius: 6rpx;
}

.zoom-chip.active {
  background: #F43F5E;
  color: #FFFFFF;
  font-weight: 600;
}

/* 2D 浮层控件 */
.tier-filter-bar {
  position: absolute;
  bottom: 12rpx;
  left: 14rpx;
  display: flex;
  gap: 6rpx;
  background: rgba(255, 255, 255, 0.9);
  padding: 5rpx;
  border-radius: 10rpx;
  border: 1rpx solid rgba(120, 95, 70, 0.2);
}

.tier-pill {
  padding: 5rpx 12rpx;
  font-size: 19rpx;
  color: #475569;
  border-radius: 6rpx;
}

.tier-pill.active {
  background: #F43F5E;
  color: #FFFFFF;
  font-weight: 600;
}

.floating-reset-2d {
  position: absolute;
  top: 12rpx;
  right: 14rpx;
  padding: 6rpx 14rpx;
  font-size: 19rpx;
  color: #1E293B;
  background: rgba(255, 255, 255, 0.9);
  border: 1rpx solid rgba(120, 95, 70, 0.22);
  border-radius: 8rpx;
}

/* 底部控制面板 */
.bottom-inspector {
  flex-shrink: 0;
  background: #f6eee3;
  border-top: 1rpx solid rgba(120, 95, 70, 0.16);
  padding: 14rpx 22rpx 18rpx;
}

.inspector-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
  gap: 10rpx;
}

.sector-title-group {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  min-width: 0;
}

.sector-badge {
  background: #F43F5E;
  color: #FFFFFF;
  font-size: 19rpx;
  font-weight: 700;
  padding: 2rpx 9rpx;
  border-radius: 6rpx;
}

.sector-name {
  font-size: 24rpx;
  font-weight: 700;
  color: #1E293B;
}

.sector-sub {
  font-size: 19rpx;
  color: #64748B;
}

.inspector-tools {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}

.mode-pill {
  display: flex;
  align-items: center;
  padding: 6rpx 14rpx;
  background: rgba(255, 255, 255, 0.88);
  border: 1rpx solid rgba(120, 95, 70, 0.2);
  border-radius: 26rpx;
  font-size: 20rpx;
  color: #1E293B;
}

.mode-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

.mode-dot.concert {
  background: #F43F5E;
  box-shadow: 0 0 8rpx rgba(244, 63, 94, 0.55);
}

.mode-dot.sports {
  background: #10B981;
  box-shadow: 0 0 8rpx rgba(16, 185, 129, 0.55);
}

.color-picker-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 12rpx;
  font-size: 20rpx;
  color: #B45309;
  background: rgba(245, 158, 11, 0.14);
  border: 1rpx solid rgba(217, 119, 6, 0.35);
  border-radius: 8rpx;
}

.color-picker-btn.active {
  color: #FFFFFF;
  background: #D97706;
  border-color: #B45309;
}

.color-btn-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(30, 41, 59, 0.35);
  flex-shrink: 0;
}

.color-picker-panel {
  margin-top: 8rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.color-target-bar {
  display: flex;
  flex-direction: row;
  white-space: nowrap;
  height: 52rpx;
}

.color-target-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 0 16rpx;
  height: 48rpx;
  margin-right: 10rpx;
  border-radius: 10rpx;
  background: rgba(255, 255, 255, 0.86);
  border: 1rpx solid rgba(120, 95, 70, 0.18);
  flex-shrink: 0;
}

.color-target-chip.active {
  background: rgba(37, 99, 235, 0.14);
  border-color: #2563EB;
}

.target-color-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(30, 41, 59, 0.35);
}

.target-label {
  font-size: 20rpx;
  font-weight: 600;
  color: #1E293B;
}

.color-swatch-bar {
  display: flex;
  flex-direction: row;
  white-space: nowrap;
  height: 86rpx;
}

.swatch-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  height: 82rpx;
  margin-right: 8rpx;
  border-radius: 10rpx;
  background: rgba(255, 255, 255, 0.85);
  border: 1rpx solid rgba(120, 95, 70, 0.16);
  flex-shrink: 0;
}

.swatch-item.active {
  background: #FFFFFF;
  border: 2rpx solid #F43F5E;
}

.swatch-chip {
  width: 38rpx;
  height: 38rpx;
  border-radius: 8rpx;
  border: 1rpx solid rgba(30, 41, 59, 0.22);
  margin-bottom: 4rpx;
}

.swatch-name {
  font-size: 17rpx;
  color: #334155;
}

.color-preset-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
}

.preset-scroll {
  flex: 1;
  display: flex;
  flex-direction: row;
  white-space: nowrap;
  height: 46rpx;
  overflow: hidden;
}

.preset-chip {
  display: inline-flex;
  align-items: center;
  height: 42rpx;
  padding: 0 14rpx;
  margin-right: 8rpx;
  border-radius: 8rpx;
  font-size: 19rpx;
  color: #334155;
  background: rgba(255, 255, 255, 0.85);
  border: 1rpx solid rgba(120, 95, 70, 0.18);
  flex-shrink: 0;
}

.preset-chip.active {
  color: #FFFFFF;
  background: #F43F5E;
  border-color: #F43F5E;
}

.color-action-group {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.color-reset-btn {
  padding: 6rpx 14rpx;
  font-size: 19rpx;
  color: #475569;
  background: rgba(255, 255, 255, 0.88);
  border: 1rpx solid rgba(120, 95, 70, 0.2);
  border-radius: 8rpx;
}

.color-done-btn {
  padding: 6rpx 16rpx;
  font-size: 19rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: #2563EB;
  border-radius: 8rpx;
}

.row-slider-wrap {
  display: flex;
  align-items: center;
  margin: 4rpx 0 10rpx;
}

.slider-label {
  font-size: 19rpx;
  color: #64748B;
  width: 180rpx;
}

.row-slider {
  flex: 1;
  margin: 0 12rpx;
}

.slider-val {
  font-size: 21rpx;
  font-weight: 600;
  color: #F43F5E;
  width: 92rpx;
  text-align: right;
}

.metrics-grid {
  display: flex;
  justify-content: space-between;
  gap: 10rpx;
  margin-bottom: 8rpx;
}

.metric-box {
  flex: 1;
  background: rgba(255, 255, 255, 0.82);
  border: 1rpx solid rgba(120, 95, 70, 0.14);
  border-radius: 10rpx;
  padding: 8rpx 10rpx;
  display: flex;
  flex-direction: column;
}

.metric-label {
  font-size: 18rpx;
  color: #64748B;
}

.metric-value {
  font-size: 23rpx;
  font-weight: 700;
  color: #1E293B;
  margin-top: 2rpx;
}

.metric-value.highlight {
  color: #059669;
}

.inspector-footer {
  display: flex;
  justify-content: space-between;
}

.footer-spec {
  font-size: 18rpx;
  color: #64748B;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ==========================================================================
   体育场切换全景加载过度动画（统一奶白色 #f6eee3 风格）
   ========================================================================== */
.venue-switch-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  background: rgba(246, 238, 227, 0.94);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: auto;
  transition: opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.venue-switch-overlay.fade-in {
  opacity: 1;
}

.venue-switch-overlay.fade-out {
  opacity: 0;
}

.switch-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 50rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(120, 95, 70, 0.18);
  box-shadow: 0 16rpx 48rpx rgba(120, 95, 70, 0.16);
  border-radius: 20rpx;
  animation: switchPop 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

@keyframes switchPop {
  0% {
    transform: scale(0.92) translateY(12rpx);
    opacity: 0;
  }
  100% {
    transform: scale(1) translateY(0);
    opacity: 1;
  }
}

.switch-loader-ring {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(244, 63, 94, 0.16);
  border-top-color: #F43F5E;
  border-right-color: #0284C7;
  animation: switchSpin 0.9s cubic-bezier(0.5, 0.1, 0.5, 0.9) infinite;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.switch-loader-inner {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 3rpx solid transparent;
  border-bottom-color: #0284C7;
  animation: switchSpinReverse 0.65s linear infinite;
}

@keyframes switchSpin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

@keyframes switchSpinReverse {
  0% { transform: rotate(360deg); }
  100% { transform: rotate(0deg); }
}

.switch-venue-code {
  font-size: 32rpx;
  font-weight: 700;
  color: #1E293B;
  letter-spacing: 1rpx;
  margin-bottom: 12rpx;
}

.switch-tip-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.switch-dot-pulse {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #F43F5E;
  animation: dotPulse 1.2s ease-in-out infinite;
}

@keyframes dotPulse {
  0%, 100% {
    transform: scale(0.8);
    opacity: 0.5;
  }
  50% {
    transform: scale(1.3);
    opacity: 1;
  }
}

.switch-tip-text {
  font-size: 21rpx;
  color: #64748B;
  letter-spacing: 0.5rpx;
}

.app-shell {
  display: flex;
  flex-direction: column;
  width: 100vw;
  height: 100vh;
  background-color: #070A12;
  color: #F8FAFC;
  overflow: hidden;
}

/* 顶部栏：仅保留简洁的场馆切换 */
.top-header {
  flex-shrink: 0;
  background: #0F1626;
  border-bottom: 1rpx solid rgba(148, 163, 184, 0.16);
  padding: 10rpx 18rpx 10rpx;
}

.venue-tabs {
  display: flex;
  white-space: nowrap;
  width: 100%;
  height: 70rpx;
}

.venue-chip {
  display: inline-flex;
  flex-direction: column;
  justify-content: center;
  padding: 6rpx 20rpx;
  margin-right: 12rpx;
  border-radius: 12rpx;
  background: rgba(30, 41, 59, 0.78);
  border: 1rpx solid rgba(148, 163, 184, 0.22);
}

.venue-chip.active {
  background: rgba(244, 63, 94, 0.18);
  border-color: #F43F5E;
}

.venue-chip-code {
  font-size: 24rpx;
  font-weight: 600;
  color: #F8FAFC;
}

.venue-chip-cap {
  font-size: 18rpx;
  color: #94A3B8;
  margin-top: 2rpx;
}

/* 主视口容器：3D 上方，2D 下方 */
.viewport-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
}

/* 打开 Schema 弹窗时将原生 canvas 整体移出视口，彻底解决微信开发者工具模拟器原生画布遮挡 textarea 的问题 */
.viewport-body.offscreen {
  position: fixed;
  left: -9999rpx;
  top: 0;
  width: 100vw;
  height: 800rpx;
  visibility: hidden;
  pointer-events: none;
}

.pane-3d,
.pane-2d {
  position: relative;
  width: 100%;
  overflow: hidden;
}

.pane-3d.split-top {
  height: 46%;
  border-bottom: 1rpx solid rgba(148, 163, 184, 0.22);
}

.pane-3d.full {
  height: 100%;
}

.pane-2d.split-bottom {
  height: 54%;
}

.pane-2d.hidden {
  height: 0;
  min-height: 0;
  overflow: hidden;
}

.canvas-el {
  width: 100%;
  height: 100%;
  display: block;
}

/* 3D 浮层控件 */
.hud-top-3d {
  position: absolute;
  top: 12rpx;
  left: 14rpx;
  right: 14rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  pointer-events: none;
}

.hud-left-3d {
  display: flex;
  align-items: center;
  gap: 10rpx;
  max-width: 78%;
}

.camera-badge {
  display: flex;
  align-items: center;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  font-size: 19rpx;
  background: rgba(15, 23, 42, 0.86);
  border: 1rpx solid rgba(148, 163, 184, 0.28);
  color: #F8FAFC;
  overflow: hidden;
}

.camera-badge.seat-mode {
  border-color: rgba(244, 63, 94, 0.65);
}

.badge-text {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.badge-dot {
  width: 10rpx;
  height: 10rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: #38BDF8;
  margin-right: 8rpx;
}

.camera-badge.seat-mode .badge-dot {
  background: #F43F5E;
}

.hud-action-btn {
  pointer-events: auto;
  flex-shrink: 0;
  padding: 6rpx 14rpx;
  font-size: 19rpx;
  font-weight: 600;
  color: #FFFFFF;
  border-radius: 8rpx;
}

.hud-action-btn.primary {
  background: #2563EB;
}

.hud-action-btn.accent {
  background: rgba(244, 63, 94, 0.9);
}

.fullscreen-btn-3d {
  pointer-events: auto;
  flex-shrink: 0;
  padding: 7rpx 16rpx;
  font-size: 20rpx;
  font-weight: 600;
  color: #F8FAFC;
  background: rgba(15, 23, 42, 0.88);
  border: 1rpx solid rgba(56, 189, 248, 0.45);
  border-radius: 8rpx;
}

.zoom-bar-3d {
  position: absolute;
  bottom: 12rpx;
  right: 14rpx;
  display: flex;
  background: rgba(15, 23, 42, 0.88);
  padding: 4rpx;
  border-radius: 10rpx;
  border: 1rpx solid rgba(148, 163, 184, 0.25);
}

.zoom-chip {
  padding: 5rpx 12rpx;
  font-size: 19rpx;
  color: #94A3B8;
  border-radius: 6rpx;
}

.zoom-chip.active {
  background: #F43F5E;
  color: #FFFFFF;
  font-weight: 600;
}

/* 2D 浮层控件 */
.tier-filter-bar {
  position: absolute;
  bottom: 12rpx;
  left: 14rpx;
  display: flex;
  gap: 6rpx;
  background: rgba(15, 23, 42, 0.86);
  padding: 5rpx;
  border-radius: 10rpx;
  border: 1rpx solid rgba(148, 163, 184, 0.24);
}

.tier-pill {
  padding: 5rpx 12rpx;
  font-size: 19rpx;
  color: #CBD5E1;
  border-radius: 6rpx;
}

.tier-pill.active {
  background: #F43F5E;
  color: #FFFFFF;
  font-weight: 600;
}

.floating-reset-2d {
  position: absolute;
  top: 12rpx;
  right: 14rpx;
  padding: 6rpx 14rpx;
  font-size: 19rpx;
  color: #E2E8F0;
  background: rgba(15, 23, 42, 0.84);
  border: 1rpx solid rgba(148, 163, 184, 0.25);
  border-radius: 8rpx;
}

/* 底部控制面板 */
.bottom-inspector {
  flex-shrink: 0;
  background: #0F1626;
  border-top: 1rpx solid rgba(148, 163, 184, 0.22);
  padding: 14rpx 22rpx 18rpx;
}

.inspector-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
  gap: 10rpx;
}

.sector-title-group {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  min-width: 0;
}

.sector-badge {
  background: #F43F5E;
  color: #FFFFFF;
  font-size: 19rpx;
  font-weight: 700;
  padding: 2rpx 9rpx;
  border-radius: 6rpx;
}

.sector-name {
  font-size: 24rpx;
  font-weight: 700;
  color: #F8FAFC;
}

.sector-sub {
  font-size: 19rpx;
  color: #94A3B8;
}

.inspector-tools {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}

.mode-pill {
  display: flex;
  align-items: center;
  padding: 6rpx 14rpx;
  background: rgba(30, 41, 59, 0.94);
  border: 1rpx solid rgba(148, 163, 184, 0.32);
  border-radius: 26rpx;
  font-size: 20rpx;
  color: #E2E8F0;
}

.mode-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

.mode-dot.concert {
  background: #F43F5E;
  box-shadow: 0 0 8rpx #F43F5E;
}

.mode-dot.sports {
  background: #10B981;
  box-shadow: 0 0 8rpx #10B981;
}

.schema-import-btn {
  padding: 6rpx 12rpx;
  font-size: 20rpx;
  color: #38BDF8;
  background: rgba(56, 189, 248, 0.14);
  border: 1rpx solid rgba(56, 189, 248, 0.38);
  border-radius: 8rpx;
}

.color-picker-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 12rpx;
  font-size: 20rpx;
  color: #FDE68A;
  background: rgba(245, 158, 11, 0.14);
  border: 1rpx solid rgba(245, 158, 11, 0.40);
  border-radius: 8rpx;
}

.color-picker-btn.active {
  color: #FFFFFF;
  background: rgba(245, 158, 11, 0.36);
  border-color: #FBBF24;
}

.color-btn-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  flex-shrink: 0;
}

.color-picker-panel {
  margin-top: 8rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.color-target-bar {
  display: flex;
  flex-direction: row;
  white-space: nowrap;
  height: 52rpx;
}

.color-target-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 0 16rpx;
  height: 48rpx;
  margin-right: 10rpx;
  border-radius: 10rpx;
  background: rgba(15, 23, 42, 0.92);
  border: 1rpx solid rgba(148, 163, 184, 0.24);
  flex-shrink: 0;
}

.color-target-chip.active {
  background: rgba(37, 99, 235, 0.26);
  border-color: #60A5FA;
}

.target-color-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(255, 255, 255, 0.7);
}

.target-label {
  font-size: 20rpx;
  font-weight: 600;
  color: #E2E8F0;
}

.color-swatch-bar {
  display: flex;
  flex-direction: row;
  white-space: nowrap;
  height: 86rpx;
}

.swatch-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  height: 82rpx;
  margin-right: 8rpx;
  border-radius: 10rpx;
  background: rgba(15, 23, 42, 0.76);
  border: 1rpx solid rgba(148, 163, 184, 0.16);
  flex-shrink: 0;
}

.swatch-item.active {
  background: rgba(248, 250, 252, 0.14);
  border: 2rpx solid #FFFFFF;
}

.swatch-chip {
  width: 38rpx;
  height: 38rpx;
  border-radius: 8rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  margin-bottom: 4rpx;
}

.swatch-name {
  font-size: 17rpx;
  color: #CBD5E1;
}

.color-preset-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
}

.preset-scroll {
  flex: 1;
  display: flex;
  flex-direction: row;
  white-space: nowrap;
  height: 46rpx;
  overflow: hidden;
}

.preset-chip {
  display: inline-flex;
  align-items: center;
  height: 42rpx;
  padding: 0 14rpx;
  margin-right: 8rpx;
  border-radius: 8rpx;
  font-size: 19rpx;
  color: #CBD5E1;
  background: rgba(30, 41, 59, 0.9);
  border: 1rpx solid rgba(148, 163, 184, 0.22);
  flex-shrink: 0;
}

.preset-chip.active {
  color: #FFFFFF;
  background: rgba(244, 63, 94, 0.28);
  border-color: #F43F5E;
}

.color-action-group {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.color-reset-btn {
  padding: 6rpx 14rpx;
  font-size: 19rpx;
  color: #94A3B8;
  background: rgba(30, 41, 59, 0.95);
  border: 1rpx solid rgba(148, 163, 184, 0.25);
  border-radius: 8rpx;
}

.color-done-btn {
  padding: 6rpx 16rpx;
  font-size: 19rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: #2563EB;
  border-radius: 8rpx;
}

.row-slider-wrap {
  display: flex;
  align-items: center;
  margin: 4rpx 0 10rpx;
}

.slider-label {
  font-size: 19rpx;
  color: #94A3B8;
  width: 180rpx;
}

.row-slider {
  flex: 1;
  margin: 0 12rpx;
}

.slider-val {
  font-size: 21rpx;
  font-weight: 600;
  color: #F43F5E;
  width: 92rpx;
  text-align: right;
}

.metrics-grid {
  display: flex;
  justify-content: space-between;
  gap: 10rpx;
  margin-bottom: 8rpx;
}

.metric-box {
  flex: 1;
  background: rgba(15, 23, 42, 0.92);
  border: 1rpx solid rgba(148, 163, 184, 0.16);
  border-radius: 10rpx;
  padding: 8rpx 10rpx;
  display: flex;
  flex-direction: column;
}

.metric-label {
  font-size: 18rpx;
  color: #64748B;
}

.metric-value {
  font-size: 23rpx;
  font-weight: 700;
  color: #E2E8F0;
  margin-top: 2rpx;
}

.metric-value.highlight {
  color: #34D399;
}

.inspector-footer {
  display: flex;
  justify-content: space-between;
}

.footer-spec {
  font-size: 18rpx;
  color: #64748B;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 导入自定义 Schema 模态框 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(7, 10, 18, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.modal-card {
  width: 670rpx;
  background: #0F1626;
  border: 1rpx solid rgba(148, 163, 184, 0.32);
  border-radius: 16rpx;
  padding: 26rpx;
  box-sizing: border-box;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.modal-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #F8FAFC;
}

.modal-header-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.paste-chip {
  padding: 6rpx 14rpx;
  font-size: 20rpx;
  color: #34D399;
  background: rgba(52, 211, 153, 0.14);
  border: 1rpx solid rgba(52, 211, 153, 0.38);
  border-radius: 8rpx;
}

.modal-close {
  font-size: 30rpx;
  color: #94A3B8;
  padding: 4rpx 8rpx;
}

.modal-desc {
  font-size: 21rpx;
  color: #94A3B8;
  line-height: 1.4;
  display: block;
  margin-bottom: 14rpx;
}

.schema-textarea {
  width: 100%;
  height: 360rpx;
  box-sizing: border-box;
  background: #070A12;
  border: 1rpx solid rgba(148, 163, 184, 0.28);
  border-radius: 10rpx;
  padding: 14rpx;
  font-size: 20rpx;
  color: #38BDF8;
  font-family: monospace;
  margin-bottom: 14rpx;
}

.schema-error {
  color: #F43F5E;
  font-size: 20rpx;
  margin-bottom: 12rpx;
}

.modal-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
}

.btn-secondary,
.btn-primary {
  margin: 0;
  font-size: 24rpx;
  padding: 0 28rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 10rpx;
}

.btn-secondary {
  background: #1E293B;
  color: #CBD5E1;
}

.btn-primary {
  background: #2563EB;
  color: #FFFFFF;
}

/* ==========================================================================
   体育场切换全景加载过度动画
   ========================================================================== */
.venue-switch-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  background: rgba(11, 15, 25, 0.88);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: auto;
  transition: opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.venue-switch-overlay.fade-in {
  opacity: 1;
}

.venue-switch-overlay.fade-out {
  opacity: 0;
}

.switch-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 50rpx;
  background: rgba(15, 23, 42, 0.85);
  border: 1rpx solid rgba(56, 189, 248, 0.25);
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.6), 0 0 32rpx rgba(56, 189, 248, 0.15);
  border-radius: 20rpx;
  animation: switchPop 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

@keyframes switchPop {
  0% {
    transform: scale(0.92) translateY(12rpx);
    opacity: 0;
  }
  100% {
    transform: scale(1) translateY(0);
    opacity: 1;
  }
}

.switch-loader-ring {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(56, 189, 248, 0.18);
  border-top-color: #38BDF8;
  border-right-color: #F43F5E;
  animation: switchSpin 0.9s cubic-bezier(0.5, 0.1, 0.5, 0.9) infinite;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.switch-loader-inner {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 3rpx solid transparent;
  border-bottom-color: #38BDF8;
  animation: switchSpinReverse 0.65s linear infinite;
}

@keyframes switchSpin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

@keyframes switchSpinReverse {
  0% { transform: rotate(360deg); }
  100% { transform: rotate(0deg); }
}

.switch-venue-code {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 1rpx;
  margin-bottom: 12rpx;
  text-shadow: 0 2rpx 10rpx rgba(56, 189, 248, 0.4);
}

.switch-tip-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.switch-dot-pulse {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #38BDF8;
  animation: dotPulse 1.2s ease-in-out infinite;
}

@keyframes dotPulse {
  0%, 100% {
    transform: scale(0.8);
    opacity: 0.5;
  }
  50% {
    transform: scale(1.3);
    opacity: 1;
  }
}

.switch-tip-text {
  font-size: 21rpx;
  color: #94A3B8;
  letter-spacing: 0.5rpx;
}

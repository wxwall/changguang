<view class="app-shell">
  <!-- 体育场切换全景加载过度动画浮层 -->
  <view wx:if="{{isVenueSwitching}}" class="venue-switch-overlay {{switchingFade ? 'fade-out' : 'fade-in'}}">
    <view class="switch-card">
      <view class="switch-loader-ring">
        <view class="switch-loader-inner"></view>
      </view>
      <text class="switch-venue-code">{{switchingVenueName}}</text>
      <view class="switch-tip-row">
        <view class="switch-dot-pulse"></view>
        <text class="switch-tip-text">3D 场馆模型构建中...</text>
      </view>
    </view>
  </view>

  <!-- 顶部栏：最左侧全部按钮 + 首页5个场馆切换 -->
  <view class="top-header">
    <view class="venue-all-btn" bindtap="onOpenAllVenues">
      <text class="venue-all-text">全部</text>
    </view>
    <scroll-view class="venue-tabs" scroll-x="true" enable-flex="true">
      <view
        wx:for="{{homeVenues}}"
        wx:key="id"
        class="venue-chip {{currentVenue.id === item.id ? 'active' : ''}}"
        data-id="{{item.id}}"
        data-doc-id="{{item._id}}"
        bindtap="onSelectVenue"
      >
        <text class="venue-chip-code">{{item.shortLabel}}</text>
        <text class="venue-chip-cap">{{item.capLabel}}</text>
      </view>
    </scroll-view>
  </view>

  <!-- 核心视口容器 -->
  <view class="viewport-body">
    <!-- 上方版块：3D WebGL 全景沉浸式视野渲染视图 -->
    <view class="pane-3d {{is3DFullscreen ? 'full' : 'split-top'}}">
      <canvas
        type="webgl"
        id="stadium3d"
        class="canvas-el"
        bindtouchstart="onTouchStart3D"
        bindtouchmove="onTouchMove3D"
        bindtouchend="onTouchEnd3D"
      ></canvas>

      <!-- 3D 顶部控制栏：视角提示 + 飞入/鸟瞰按钮 + 全屏切换 -->
      <view class="hud-top-3d">
        <view class="hud-left-3d">
          <view class="camera-badge {{cameraMode === 'seat' ? 'seat-mode' : 'bird-mode'}}">
            <text class="badge-dot"></text>
            <text class="badge-text">{{cameraMode === 'bird' ? '3D 全景鸟瞰 · 点击3D/2D选座' : '座席实景 · ' + sightline.sectorName + ' ' + sightline.row + '排'}}</text>
          </view>
          <view wx:if="{{cameraMode === 'seat'}}" class="hud-action-btn primary" bindtap="onReturnBirdEye">
            返回鸟瞰
          </view>
          <view wx:else class="hud-action-btn accent" bindtap="onFlyToSelectedSeat">
            进入所选视角
          </view>
        </view>

        <view class="hud-right-3d">
          <view class="hud-action-btn scene-btn" bindtap="onToggleScene">
            {{activeSceneId === 'floating-island' ? '仙境' : '广场'}}
          </view>
          <view class="fullscreen-btn-3d" bindtap="onToggle3DFullscreen">
            {{is3DFullscreen ? '退出全屏' : '全屏'}}
          </view>
        </view>
      </view>

      <!-- 3D 舞台实景动态光学变焦 (0.5x ~ 5x) -->
      <view class="zoom-bar-3d">
        <view
          wx:for="{{zoomOptions}}"
          wx:key="value"
          class="zoom-chip {{zoomLevel === item.value ? 'active' : ''}}"
          data-zoom="{{item.value}}"
          bindtap="onSelectZoom"
        >{{item.label}}</view>
      </view>
    </view>

    <!-- 下方版块：2D 平面交互选座视图 (全屏时隐藏但保持挂载) -->
    <view class="pane-2d {{is3DFullscreen ? 'hidden' : 'split-bottom'}}">
      <canvas
        type="2d"
        id="seatmap2d"
        class="canvas-el"
        bindtouchstart="onTouchStart2D"
        bindtouchmove="onTouchMove2D"
        bindtouchend="onTouchEnd2D"
      ></canvas>

      <!-- 2D 看台层级过滤悬浮条 -->
      <view class="tier-filter-bar">
        <view
          class="tier-pill {{activeTierFilter === 'all' ? 'active' : ''}}"
          data-level="all"
          bindtap="onFilterTier"
        >全部</view>
        <view
          wx:for="{{currentVenue.standTiers}}"
          wx:key="id"
          class="tier-pill {{activeTierFilter === item.level ? 'active' : ''}}"
          data-level="{{item.level}}"
          bindtap="onFilterTier"
        >{{item.level}}F</view>
      </view>

      <!-- 2D 重置缩放按钮 -->
      <view class="floating-reset-2d" bindtap="onReset2D">重置平面</view>
    </view>
  </view>

  <!-- 底部控制面板：选区信息 + 演唱会舞美切换 + 自定义Schema + 排数滑块 + 视野指标 -->
  <view class="bottom-inspector">
    <view class="inspector-header">
      <view class="sector-title-group">
        <text class="sector-badge">{{sightline.tierLevel ? sightline.tierLevel + 'F' : '内场'}}</text>
        <text class="sector-name">{{sightline.sectorName}}</text>
        <text class="sector-sub">{{sightline.row}}排 {{sightline.seatNo}}座</text>
      </view>

      <view class="inspector-tools">
        <view class="color-picker-btn {{showColorPicker ? 'active' : ''}}" bindtap="onToggleColorPicker">
          <view class="color-btn-dot" style="background: {{activeTargetHex}};"></view>
          <text>场馆配色</text>
        </view>
        <!-- 演唱会舞美 / 标准赛场 切换（已移至底部控制面板） -->
        <view class="mode-pill" bindtap="onToggleViewMode">
          <view class="mode-dot {{viewMode === 'concert' ? 'concert' : 'sports'}}"></view>
          <text>{{viewMode === 'concert' ? '演唱会' : '标准赛场'}}</text>
        </view>
      </view>
    </view>

    <!-- 固定楼层座椅配色选择器（实时同步 3D 座椅与 2D 分区，不遮挡原生 Canvas） -->
    <view wx:if="{{showColorPicker}}" class="color-picker-panel">
      <scroll-view class="color-target-bar" scroll-x="true" enable-flex="true">
        <view
          wx:for="{{colorTargets}}"
          wx:key="key"
          class="color-target-chip {{activeColorTarget === item.key ? 'active' : ''}}"
          data-key="{{item.key}}"
          bindtap="onSelectColorTarget"
        >
          <view class="target-color-dot" style="background: {{item.hex}};"></view>
          <text class="target-label">{{item.label}}</text>
        </view>
      </scroll-view>

      <scroll-view class="color-swatch-bar" scroll-x="true" enable-flex="true">
        <view
          wx:for="{{seatColorSwatches}}"
          wx:key="hex"
          class="swatch-item {{activeTargetHex === item.hex ? 'active' : ''}}"
          data-hex="{{item.hex}}"
          bindtap="onPickSeatColor"
        >
          <view class="swatch-chip" style="background: {{item.hex}};"></view>
          <text class="swatch-name">{{item.name}}</text>
        </view>
      </scroll-view>

      <view class="color-preset-row">
        <scroll-view class="preset-scroll" scroll-x="true" enable-flex="true">
          <view
            wx:for="{{seatThemePresets}}"
            wx:key="id"
            class="preset-chip {{activeThemePreset === item.id ? 'active' : ''}}"
            data-id="{{item.id}}"
            bindtap="onApplyColorPreset"
          >{{item.name}}</view>
        </scroll-view>
        <view class="color-action-group">
          <view class="color-reset-btn" bindtap="onResetSeatColors">重置</view>
          <view class="color-done-btn" bindtap="onToggleColorPicker">完成</view>
        </view>
      </view>
    </view>

    <!-- 默认状态：排数滑块 + 四维视野指标 -->
    <block wx:else>
      <!-- 实时排数拖动预览 (精确联动 3D 仰角、视距与 C-Value) -->
      <view class="row-slider-wrap">
        <text class="slider-label">排数微调 (1-{{sightline.maxRows}}排)</text>
        <slider
          class="row-slider"
          min="1"
          max="{{sightline.maxRows}}"
          value="{{sightline.row}}"
          disabled="{{sightline.maxRows <= 1}}"
          activeColor="#F43F5E"
          backgroundColor="#E5D9C8"
          block-size="16"
          bindchanging="onRowChanging"
          bindchange="onRowChange"
        />
        <text class="slider-val">第 {{sightline.row}} 排</text>
      </view>

      <!-- 四维工程视野指标卡 -->
      <view class="metrics-grid">
        <view class="metric-box">
          <text class="metric-label">舞台/球场视距</text>
          <text class="metric-value">{{sightline.distanceM}}m</text>
        </view>
        <view class="metric-box">
          <text class="metric-label">人眼视线标高</text>
          <text class="metric-value">{{sightline.elevationM}}m</text>
        </view>
        <view class="metric-box">
          <text class="metric-label">垂直俯仰角</text>
          <text class="metric-value">{{sightline.verticalAngleDeg}}°</text>
        </view>
        <view class="metric-box">
          <text class="metric-label">C-Value 视线净高</text>
          <text class="metric-value highlight">{{sightline.cValueMm}}mm</text>
        </view>
      </view>

      <view class="inspector-footer">
        <text class="footer-spec">坡度 {{sightline.slopeDeg}}° · 排距 {{sightline.rowPitch}}m · {{sightline.guardrailMaterial}} · {{sightline.cValueStatus}}</text>
      </view>
    </block>
  </view>
</view>
